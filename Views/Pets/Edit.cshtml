@model sistema.ViewModels.PetFormViewModel
<h1>Editar pet</h1>
<form asp-action="Edit" method="post">
<div asp-validation-summary="All" class="text-danger"></div>
<input asp-for="Id" type="hidden" />
<div class="mb-3"><label asp-for="Nome" class="form-label"></label>
<input asp-for="Nome" type="text" class="form-control" />
<span asp-validation-for="Nome" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Especie" class="form-label"></label>
<input asp-for="Especie" type="text" class="form-control" />
<span asp-validation-for="Especie" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Raca" class="form-label"></label>
<input asp-for="Raca" type="text" class="form-control" />
<span asp-validation-for="Raca" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="DataNascimento" class="form-label"></label>
<input asp-for="DataNascimento" type="date" class="form-control" />
<span asp-validation-for="DataNascimento" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="TutorId" class="form-label"></label>
<select asp-for="TutorId" asp-items="ViewBag.TutorId" class="form-select"><option value="">Selecione...</option></select>
<span asp-validation-for="TutorId" class="text-danger"></span></div>
<button type="submit" class="btn btn-primary">Salvar</button>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }